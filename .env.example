# Variáveis públicas compiladas no site; o workflow de Pages copia este arquivo para .env.
# Não coloque credenciais privadas aqui: os valores PUBLIC_* aparecem no site publicado.
# Origem HTTPS, sem subcaminho. O padrão é https://<owner>.github.io.
# PUBLIC_SITE_URL=https://yrickzc.github.io
# Base independente da origem; local usa / e GitHub Actions detecta /PES_Ricks.
# PUBLIC_BASE_PATH=/PES_Ricks
# Número de contato no formato internacional, sem +, espaços ou pontuação.
PUBLIC_WHATSAPP_NUMBER=5591982556056
PUBLIC_YOUTUBE_URL=https://www.youtube.com/@yRickz
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yrick_c/
