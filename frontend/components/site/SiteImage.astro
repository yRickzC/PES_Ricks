---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
};

const { src, loading = "lazy", ...attributes } = Astro.props;
const images = import.meta.glob<ImageMetadata>("/public/**/*.{avif,gif,jpeg,jpg,png,svg,webp,AVIF,GIF,JPEG,JPG,PNG,SVG,WEBP}", { import: "default" });
const loadImage = images[`/public${src}`];
const localImage = loadImage ? await loadImage() : undefined;
if (src.startsWith("/") && !localImage) {
  throw new Error(`Imagem local não encontrada em public: ${src}`);
}
---

{localImage ? (
  <Image src={localImage} loading={loading} {...attributes} />
) : (
  <Image src={src} inferSize loading={loading} {...attributes} />
)}
