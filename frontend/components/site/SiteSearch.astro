---
import type { Locale } from "../../config/i18n";
import { searchCategories } from "../../../backend/search/search";
import { taxonomyTypes } from "../../../backend/content/taxonomy";
import { readBlogContent } from "../../paginas/blogs/data/public-content";
import type { Messages } from "../../utils/translations";
import Icon from "./Icon.astro";
import SearchInput from "./search/SearchInput.astro";
import SearchFilters from "./search/SearchFilters.astro";
import SearchResults from "./search/SearchResults.astro";
import { createSearchCatalog } from "./search/catalog";

interface Props {
  locale: Locale;
  copy: Messages;
}

const { locale, copy } = Astro.props;
const { database } = await readBlogContent();
const records = createSearchCatalog(database.list({ kind: "article", locale }), locale, copy);
const types = taxonomyTypes(locale);
const categories = searchCategories(types.flatMap(({ categories }) => categories), "all", locale);
---

<dialog class="site-search" id="site-search" aria-labelledby="search-title" data-site-search data-locale={locale} data-result-template={copy.searchResults} data-search-hint={copy.searchHint}>
  <div class="search-content">
    <div class="search-card search-controls-card">
      <div class="search-heading">
        <h2 id="search-title">{copy.searchTitle}</h2>
        <button type="button" class="icon-button" aria-label={copy.closeSearch} data-close-search><Icon name="close" size={18} /></button>
      </div>
      <form role="search" aria-label={copy.searchLabel} data-search-form>
        <SearchInput copy={copy} />
        <SearchFilters copy={copy} types={types} categories={categories} />
      </form>
    </div>
    <div class="search-card search-result-area">
      <SearchResults copy={copy} records={records} />
    </div>
  </div>
</dialog>

<script>
  import { initializeSiteSearch } from "../../utils/site-search";
  initializeSiteSearch();
</script>
