---
import type { Messages } from "../../../utils/translations";
import Icon from "../Icon.astro";
interface Props { copy: Messages }
const { copy } = Astro.props;
---

<div class="search-input-row">
  <div class="search-field">
    <label class="visually-hidden" for="site-search-input">{copy.searchLabel}</label>
    <input type="search" id="site-search-input" name="q" placeholder={copy.searchPlaceholder} autocomplete="off" spellcheck="false" aria-controls="site-search-results" aria-describedby="site-search-status" />
    <kbd aria-hidden="true">Esc</kbd>
  </div>
  <button class="search-submit" type="submit" aria-label={copy.searchLabel} title={copy.searchLabel}>
    <Icon name="search" size={22} />
  </button>
</div>
