---
import type { TaxonomyIcon } from "../../../backend/content/taxonomy";
interface Props { icon: TaxonomyIcon; size?: number }
const { icon, size = 20 } = Astro.props;
---

<svg width={size} height={size} viewBox={icon.viewBox ?? "0 0 24 24"} fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={icon.path} />
</svg>
