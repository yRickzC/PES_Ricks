---
// Each sky/curtain instance owns its paint servers, including during navigation.
const gradientId = `meteor-${crypto.randomUUID()}`;
---

<!-- No intrinsic aspect ratio or in-flow boxes: the positioned sky owns geometry. -->
<svg class="shooting-stars" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${gradientId}-trail`}>
      <stop stop-color="#fff" />
      <stop offset="18%" stop-color="#d6c4ff" stop-opacity=".9" />
      <stop offset="100%" stop-color="#d6c4ff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id={`${gradientId}-glow`}>
      <stop stop-color="#cfb7ff" stop-opacity=".65" />
      <stop offset="100%" stop-color="#cfb7ff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g class="shooting-star">
    <g transform="rotate(-32)">
      <rect class="shooting-star-trail" x="0" y="-1" width="90" height="2" rx="1" fill={`url(#${gradientId}-trail)`} />
      <circle r="10" fill={`url(#${gradientId}-glow)`} />
      <circle r="2" fill="#fff" />
    </g>
  </g>
</svg>

<script>
  // One observer for every sky, including the sticky Services scene and curtain.
  const skies = new Map<SVGSVGElement, number>();
  let observer: IntersectionObserver;

  function updateActiveSky() {
    let active: SVGSVGElement | undefined;
    let largest = 0;
    if (!document.hidden) {
      for (const [sky, ratio] of skies) {
        if (ratio <= 0) continue;
        if (sky.closest(".page-transition:not([hidden])")) { active = sky; break; }
        if (ratio > largest) { active = sky; largest = ratio; }
      }
    }
    skies.forEach((_, sky) => sky.toggleAttribute("data-meteor-active", sky === active));
  }

  function unmount() {
    observer?.disconnect();
    skies.forEach((_, sky) => sky.removeAttribute("data-meteor-active"));
    skies.clear();
  }

  function mount() {
    unmount();
    observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => skies.set(entry.target as SVGSVGElement, entry.isIntersecting ? entry.intersectionRatio : 0));
      updateActiveSky();
    }, { threshold: [0, 0.5, 1] });
    document.querySelectorAll<SVGSVGElement>("svg.shooting-stars").forEach((sky) => {
      skies.set(sky, 0);
      observer.observe(sky);
    });
  }

  mount();
  document.addEventListener("astro:page-load", mount);
  document.addEventListener("astro:before-swap", unmount);
  document.addEventListener("visibilitychange", updateActiveSky);
</script>

<style>
  .shooting-stars {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    contain: strict;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    visibility: hidden;
  }

  .shooting-stars[data-meteor-active] { visibility: visible; }

  .shooting-star {
    --star-travel-x: -65vw;
    --star-travel-y: 40.6vw;
    transform-box: view-box;
    opacity: 0;
  }

  .shooting-star-trail { width: clamp(90px, 10vw, 180px); }

  @media (prefers-reduced-motion: no-preference) {
    .shooting-star {
      animation: shooting-star-pass 24s linear infinite;
      animation-play-state: paused;
    }

    .shooting-stars[data-meteor-active] .shooting-star {
      animation-play-state: running;
    }
  }

  @keyframes shooting-star-pass {
    /* One persistent meteor. Reposition only between flights, at zero opacity. */
    0% { opacity: 0; transform: translate3d(86%, 12%, 0); }
    2%, 14% { opacity: 1; }
    18%, 24% {
      opacity: 0;
      transform: translate3d(calc(86% + var(--star-travel-x)), calc(12% + var(--star-travel-y)), 0);
    }
    25% { opacity: 0; transform: translate3d(98%, 35%, 0); }
    27%, 39% { opacity: 1; }
    43%, 49% {
      opacity: 0;
      transform: translate3d(calc(98% + var(--star-travel-x)), calc(35% + var(--star-travel-y)), 0);
    }
    50% { opacity: 0; transform: translate3d(57%, 4%, 0); }
    52%, 64% { opacity: 1; }
    68%, 74% {
      opacity: 0;
      transform: translate3d(calc(57% + var(--star-travel-x)), calc(4% + var(--star-travel-y)), 0);
    }
    75% { opacity: 0; transform: translate3d(34%, 8%, 0); }
    77%, 89% { opacity: 1; }
    93%, 100% {
      opacity: 0;
      transform: translate3d(calc(34% + var(--star-travel-x)), calc(8% + var(--star-travel-y)), 0);
    }
  }

  @media (max-width: 760px) {
    .shooting-star {
      --star-travel-x: -95vw;
      --star-travel-y: 59.4vw;
    }
    .shooting-star-trail { width: 90px; }
  }
</style>
