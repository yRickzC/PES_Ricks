---
import "./styles/global.css";
import "./styles/site.css";
import PageTransition from "./components/site/PageTransition.astro";
import SiteHeader from "./components/site/SiteHeader.astro";
import SiteFooter from "./components/site/SiteFooter.astro";
import SiteSearch from "./components/site/SiteSearch.astro";
import { defaultLocale, documentLanguages, locales, type Locale } from "./config/i18n";
import { sitePages, type PageId } from "./config/navigation";
import { getMessages } from "./utils/translations";
import { withBasePath } from "./utils/base-path";

interface Props {
  locale?: Locale;
  pageId?: PageId;
  title?: string;
  description?: string;
  languagePaths?: Partial<Record<Locale, string>>;
}

const {
  locale = locales.find((locale) => locale === Astro.currentLocale) ?? defaultLocale,
  pageId = "home",
  title,
  description,
  languagePaths,
} = Astro.props;
const copy = getMessages(locale);
const page = sitePages.find(({ id }) => id === pageId)!;
const pageTitle = title ?? copy[page.titleKey];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={documentLanguages[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? copy.description} />
    <meta name="theme-color" content="#07070a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" type="text/plain" href={withBasePath("/llms.txt", import.meta.env.BASE_URL)} />
    <link rel="ard" type="application/json" href={withBasePath("/.well-known/ard.json", import.meta.env.BASE_URL)} />
    <link rel="ai-catalog" type="application/json" href={withBasePath("/.well-known/ai-catalog.json", import.meta.env.BASE_URL)} />
    <link rel="icon" type="image/x-icon" href={withBasePath("/favicon.ico", import.meta.env.BASE_URL)} />
    <title>{`${pageTitle} - Rickz`}</title>
  </head>
  <body>
    <PageTransition />
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <div class="site-frame lab-atmosphere">
      <div class="site-grid" aria-hidden="true"></div>
      <SiteHeader locale={locale} pageId={pageId} copy={copy} languagePaths={languagePaths} />
      <main class="site-content" id="main-content">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <SiteSearch locale={locale} copy={copy} />
  </body>
</html>
