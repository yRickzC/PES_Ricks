---
import type { BlogCopy } from "../../data/explore-copy";
interface Props { copy: BlogCopy }
const { copy } = Astro.props;
---
<form class="blog-explore-search" data-blog-form role="search" aria-label={copy.searchLabel}>
  <label class="blog-explore-sr" for="blog-query">{copy.searchLabel}</label>
  <input id="blog-query" name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" aria-controls="blog-explore-results" data-blog-query />
  <button type="submit" aria-label={copy.submit}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.75" cy="10.75" r="6.75"/><path d="m16 16 4.5 4.5"/></svg>
  </button>
</form>
