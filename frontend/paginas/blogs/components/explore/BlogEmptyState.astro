---
import ContentEmptyState from "../../../../components/site/ContentEmptyState.astro";
import type { BlogCopy } from "../../data/explore-copy";
interface Props { copy: BlogCopy; hidden: boolean }
const { copy, hidden } = Astro.props;
---
<ContentEmptyState class="blog-explore-empty" data-blog-empty hidden={hidden} title={copy.emptyTitle} hint={copy.emptyHint} dogAlt={copy.dogAlt}>
  <button type="button" class="blog-explore-clear" data-blog-clear>{copy.clear}</button>
</ContentEmptyState>
