---
import Main from "../../main.astro";
import BlogHero from "./components/BlogHero.astro";
import BlogExploreSection from "./components/explore/BlogExploreSection.astro";
import { defaultLocale, locales } from "../../config/i18n";
import { getMessages } from "../../utils/translations";
import { createBlogPosts } from "./data/explore-catalog";
import { prepareBlogCovers } from "./data/explore-images";
import { readBlogContent } from "./data/public-content";
import "./styles/blogs.css";

const locale = locales.find((value) => value === Astro.currentLocale) ?? defaultLocale;
const copy = getMessages(locale);
const { database } = await readBlogContent();
const posts = await prepareBlogCovers(createBlogPosts(database.list({ kind: "article", contentType: "blog", locale }), locale, import.meta.env.BASE_URL), import.meta.env.BASE_URL);
---

<Main locale={locale} pageId="blogs" title={`${copy.blogHeroTitle} — Rickz`} description={copy.blogHeroSubtitle}>
  <BlogHero copy={copy} locale={locale} />
  <BlogExploreSection posts={posts} locale={locale} label={copy.blogExploreNotes} />
</Main>
