---
import type { LandingCopy } from "../config/landing";
interface Props { copy: LandingCopy }
const { copy } = Astro.props;
---

<figure class="lp-figure">
  <div class="lp-scene" role="img" aria-label={copy.sceneAlt}>
    <div class="lp-scene-art" aria-hidden="true">
      <div class="lp-ambient"></div>
      <div class="lp-comparison-light"></div>
      <div class="lp-chat">
        <div class="lp-chat-bar">
          <span class="lp-chat-avatar">{copy.storeName.charAt(0)}</span>
          <span><strong>{copy.storeName}</strong><small>WhatsApp</small></span>
          <svg viewBox="0 0 24 24" fill="none"><path d="m7 3 4 5-3 3a13 13 0 0 0 5 5l3-3 5 4c-2 8-10 3-14-1S-2 5 7 3Z"/></svg>
        </div>
        <div class="lp-chat-body" data-landing-viewport="chat">
          <div class="lp-chat-thread">
          <div class="lp-chat-offer">
            <div class="lp-chat-product"><span>{copy.storeName}</span><svg viewBox="0 0 120 100" fill="none"><rect x="25" y="12" width="52" height="76" rx="3"/><path d="M36 12v76m11-55h20M47 44h16m-16 11h20m18-33 9 3-14 56-7 8-2-11Zm-13 55 9 3"/></svg><small>{copy.productLabel}</small></div>
            <p>{copy.chatOffer}</p><small>09:41 <span>✓✓</span></small>
          </div>
          <div class="lp-chat-questions">
            {copy.visitorQuestions.map((question, index) => <p class="lp-chat-bubble" style={`--lp-question: var(--lp-q${index}, 0)`}>{question}<small>09:42 <span>✓</span></small></p>)}
          </div>
          </div>
        </div>
        <div class="lp-chat-compose"><span>＋</span><span>{copy.chatPlaceholder}</span><svg viewBox="0 0 24 24" fill="none"><rect x="8" y="2" width="8" height="14" rx="4"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4m-4 0h8"/></svg></div>
      </div>
      <div class="lp-person lp-person-confused">
        <span>{copy.visitorThoughts}</span>
        <svg viewBox="0 0 280 320" fill="none">
          <!-- Independent contours keep the neck, arms and hands connected. -->
          <path d="M88 123 92 101 80 86 77 51 92 29 126 24 150 40 159 66 150 77 148 101 128 116 124 131 108 138 88 123Z"/>
          <path d="M88 123 62 134 42 165 30 237 42 260 85 272 126 259M68 212 74 245 115 253 140 244"/>
          <path d="M124 131 145 143 162 170 171 225 182 211 186 183M171 247 184 252 207 218 203 187"/>
          <path d="m77 54 14-1 12-15 20 8 24-1M97 70l10-4m22 2 10 4m-22 4 3 12-9 1m-10 13 14-4 12 2"/>
          <g transform="rotate(14 201 121)">
            <!-- Leave the phone outline open where the thumb and fingers grip it. -->
            <path d="M201 150V125Q201 121 205 121H225Q229 121 229 125V149M229 166V167Q229 171 225 171H205Q201 171 201 167V164"/>
            <path d="M211 163h8"/>
            <path d="M201 185V179Q195 173 195 165V156Q195 152 198 152Q200 152 202 155L207 162Q210 165 212 162Q213 160 211 157L205 150"/>
            <path d="M219 185Q226 179 230 171Q233 166 233 161V153Q233 149 229 149H227Q224 149 224 152Q224 155 227 155H233M226 155Q223 155 223 158Q223 161 226 161H233M226 161Q223 161 223 164Q223 167 226 167H231"/>
            <path d="M201 179Q209 182 219 179"/>
          </g>
          <path d="M55 264 51 291M166 247 174 291M29 291h176M68 291 63 314M148 291 154 314"/>
          <g class="lp-person-doubts"><path d="M216 63c-1-14 21-17 22-2 1 9-11 9-11 17m0 8v2M49 54c-1-11 16-13 17-2 1 7-8 7-8 13m0 7v2"/><path d="m159 16 9-8m4 27 13-1"/></g>
        </svg>
      </div>
      <div class="lp-store-devices">
        {(["desktop", "phone"] as const).map(device => <div class={`lp-device lp-device-${device}`}>
          <div class="lp-device-chrome"><span></span><span></span><span></span><small>store.example</small></div>
          <div class="lp-device-viewport" data-landing-viewport={device}>
            <div class="lp-store-content">
              <div class="lp-store-nav"><strong>{copy.storeName}</strong><span>{copy.storeCollection}</span><span>↗</span></div>
              <div class="lp-store-hero">
                <div><small>{copy.productLabel}</small><strong>{copy.demoTitle}</strong><p>{copy.demoDescription}</p><span class="lp-store-action">{copy.demoAction} ↗</span></div>
                <div class="lp-store-kit"><span>{copy.storeName}</span><svg viewBox="0 0 120 140" fill="none"><rect x="22" y="26" width="57" height="88" rx="3"/><path d="M35 26v88m12-63h21M47 64h16m-16 13h21m21-43 9 3-16 65-7 9-2-12Zm-15 64 9 3"/></svg><small>{copy.productLabel}</small></div>
              </div>
              <div class="lp-store-benefits">{copy.demoBenefits.map(benefit => <span>↗ {benefit}</span>)}</div>
              <div class="lp-store-collection"><small>{copy.storeCollection}</small><strong>{copy.storeDiscover}</strong><p>{copy.storeDescription}</p></div>
              <div class="lp-store-grid">{copy.storeProducts.map((product, index) => <div class="lp-store-card">
                <div class={`lp-store-object lp-store-object-${index}`}>
                  <svg viewBox="0 0 140 140" fill="none">
                    {index === 0 ? <><rect x="28" y="26" width="57" height="88" rx="3"/><path d="M41 26v88m12-63h21M53 64h16m-16 13h21m21-43 9 3-16 65-7 9-2-12Zm-15 64 9 3"/></> : index === 1 ? <><rect x="33" y="22" width="74" height="96" rx="3"/><path d="M44 22v96m15-68h32M59 61h23m-23 12h32m-32 12h23"/></> : index === 2 ? <><path d="M26 34h88v76H26Zm0 16h88M45 27v15m50-15v15M44 65h15m15 0h20M44 80h15m15 0h20m-50 15h15"/></> : <><path d="m39 43 64-12 15 73-64 13ZM25 33l63-12 3 14m-66-2 13 71 13-2"/><circle cx="78" cy="73" r="18"/><path d="m67 73 8 8 15-18"/></>}
                  </svg>
                </div>
                <strong>{product.name}</strong><p>{product.description}</p><span>{copy.storeDetails} ↗</span>
              </div>)}</div>
              <div class="lp-store-footer">{copy.storeName} <span>{copy.storeCollection}</span></div>
            </div>
          </div>
          <div class="lp-device-scroll"><span></span></div>
          {device === "desktop" && <svg class="lp-store-cursor" viewBox="0 0 24 28" fill="none"><path d="M3 2v20l5-5 4 9 4-2-4-8h8L3 2Z" fill="#f4f4f6" stroke="#21192e" stroke-width="1.5"/></svg>}
        </div>)}
      </div>
      <div class="lp-person lp-person-browsing">
        <span>{copy.storeCustomer}</span>
        <svg viewBox="0 0 300 320" fill="none">
          <path d="M77 129 81 105 71 89 68 58 81 37 109 30 137 43 147 71 138 85 136 109 115 121 111 135 95 145 77 129Z"/>
          <path d="M77 129 50 144 38 173 31 239 47 255 118 261 164 257M111 135 131 142 150 168 162 222 191 228"/>
          <path d="M76 195 73 231 92 247 159 253 175 244 190 246 201 254 181 257M181 251 194 260"/>
          <path d="m70 62 17-3 13-14 27 12 15-2M88 79l9-2m23-2 8 3m-23 3 3 11-7 2m-11 7q13 11 25-1"/>
          <path d="M20 268h268v10H20Zm32 10-6 36m210-36 6 36M171 254l18-75h90l-19 75Zm0 0h89m-41-42h23"/>
          <g transform="rotate(8 259 224)">
            <rect x="259" y="224" width="20" height="35" rx="3"/>
            <path d="M265 252h8"/>
          </g>
          <path class="lp-person-doubts" d="m175 57 10 10 20-23m-45 44 5 5 10-12"/>
        </svg>
      </div>
    </div>
  </div>
  <figcaption>{copy.demoNote}</figcaption>
</figure>
