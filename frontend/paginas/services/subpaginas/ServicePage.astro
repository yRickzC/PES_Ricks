---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import Main from "../../../main.astro";
import ContentEmptyState from "../../../components/site/ContentEmptyState.astro";
import type { Locale } from "../../../config/i18n";
import { getServiceCopy, serviceCategoryIds, serviceOfferSlugs } from "../config/catalog";

export const getStaticPaths = (({ routePattern }) => {
  const locale = routePattern.split("/").includes("pt-br") ? "pt-br" : "en";
  const copy = getServiceCopy(locale);

  return serviceCategoryIds.flatMap((category) =>
    serviceOfferSlugs[category].map((id, index) => ({
      params: { id },
      props: { locale, id, title: copy[category].offers[index].title },
    })),
  );
}) satisfies GetStaticPaths;

interface Props { locale: Locale; id: string; title: string }
const { locale, id, title } = Astro.props;
const copy = getServiceCopy(locale).construction;
const path = `services/${id}/`;
const languagePaths = {
  en: getRelativeLocaleUrl("en", path),
  "pt-br": getRelativeLocaleUrl("pt-br", path),
};
---

<Main locale={locale} pageId="services" title={title} description={copy.title} languagePaths={languagePaths}>
  <section class="service-construction" aria-labelledby="service-title">
    <h1 id="service-title">{title}</h1>
    <ContentEmptyState
      headingLevel="h2"
      title={copy.title}
      hint={copy.hint}
      dogSrc="/images/Dog_Worker.webp"
      dogAlt={copy.dogAlt}
    >
      <a class="service-construction-back" data-service-back href={`${getRelativeLocaleUrl(locale, "services/")}#services`}>
        <span aria-hidden="true">←</span> {copy.back}
      </a>
    </ContentEmptyState>
  </section>
</Main>

<script>
  const back = document.querySelector<HTMLAnchorElement>("[data-service-back]");
  back?.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (history.length < 2 || !document.referrer) return;
    // Links diretos e entradas de outros sites usam o catálogo como retorno.
    const previous = new URL(document.referrer);
    if (previous.origin !== location.origin) return;
    event.preventDefault();
    history.back();
  });
</script>

<style>
  .service-construction {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: calc(100svh - 160px);
    padding: clamp(48px, 8vw, 96px) 16px 24px;
    text-align: center;
  }

  h1 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 550;
    line-height: 1.12;
    letter-spacing: -.04em;
    text-wrap: balance;
  }

  .service-construction-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 8px;
    padding: 12px 22px;
    border: 1px solid rgb(177 149 248 / 40%);
    border-radius: 8px;
    background: var(--color-bg-1);
    color: var(--color-text-primary);
    text-decoration: none;
    box-shadow: 0 3px 0 #332545, 0 8px 24px rgb(0 0 0 / 25%);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .service-construction-back:focus-visible {
    outline: 2px solid var(--color-brand-light);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .service-construction-back:hover {
      transform: translateY(-2px);
      border-color: var(--color-brand-light);
    }
  }

  .service-construction-back:active { transform: translateY(2px); }

  @media (prefers-reduced-motion: reduce) {
    .service-construction-back { transition: none; transform: none; }
  }
</style>
