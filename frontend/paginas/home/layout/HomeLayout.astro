---
import Main from "../../../main.astro";
import type { Locale } from "../../../config/i18n";
import type { Messages } from "../../../utils/translations";
import "../../../styles/scroll-reveal.css";

interface Props {
  locale: Locale;
  copy: Messages;
}

const { locale, copy } = Astro.props;
---

<Main
  locale={locale}
  pageId="home"
  description={copy.description}
>
  <div class="home-layout">
    <slot />
  </div>
</Main>

<script>
  const mounted = new WeakSet<Element>();
  let generation = 0;

  async function mountHomeReveal() {
    const home = document.querySelector(".home-layout");
    if (!home || mounted.has(home)) return;

    const pendingGeneration = generation;
    const { mountScrollReveal } = await import("../../../utils/scroll-reveal");
    if (pendingGeneration !== generation || !home.isConnected || mounted.has(home)) return;

    const targets = Array.from(home.querySelectorAll<HTMLElement>("[data-home-reveal], [data-home-reveal-group] > *"));
    const footer = home.closest(".site-frame")?.querySelector<HTMLElement>(".site-footer");
    if (footer) targets.push(footer);

    // Already visible content stays visible when this enhancement arrives.
    mountScrollReveal(home, targets.filter((target) => target.getBoundingClientRect().top >= window.innerHeight));
    mounted.add(home);
  }

  function scheduleHomeReveal() {
    if (document.readyState === "complete") void mountHomeReveal();
    else window.addEventListener("load", () => void mountHomeReveal(), { once: true });
  }

  scheduleHomeReveal();
  document.addEventListener("astro:page-load", scheduleHomeReveal);
  document.addEventListener("astro:before-swap", () => { generation += 1; });
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .home-layout { --scroll-reveal-offset: 24px; }

    .home-layout .hero-subtitle,
    .home-layout .hero-layer--moon,
    .home-layout .hero-layer--gears,
    .home-layout [data-home-reveal-group] > :nth-child(2) { --scroll-reveal-delay: 70ms; }

    .home-layout .hero-description,
    .home-layout .hero-layer--island { --scroll-reveal-delay: 140ms; }
    .home-layout .hero-action--primary { --scroll-reveal-delay: 210ms; }
    .home-layout .hero-action--secondary { --scroll-reveal-delay: 280ms; }

    .home-layout .hero-layer--sky,
    .home-layout .hero-layer--moon,
    .home-layout .hero-fog-position,
    .site-footer[data-scroll-reveal-state] { --scroll-reveal-offset: 12px; }
  }
</style>
