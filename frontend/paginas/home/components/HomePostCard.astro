---
import type { BlogPost } from "../../blogs/data/explore";
import type { Messages } from "../../../utils/translations";
import SiteImage from "../../../components/site/SiteImage.astro";

interface Props { post?: BlogPost; copy: Messages; image?: boolean; position: number }
const { post, copy, image = false, position } = Astro.props;
const Card = post ? "a" : "div";
---

<Card class:list={["home-news-card", { "home-news-card--image": image, "home-news-card--empty": !post }]} href={post?.href}>
  {image && <div class="home-news-art">
    {post ? <img src={post.cover.src} srcset={post.cover.srcset} width={post.cover.width} height={post.cover.height} alt={post.cover.alt} sizes="(max-width: 639px) 90vw, (max-width: 899px) 50vw, 600px" loading="lazy" decoding="async" />
      : <SiteImage class="home-news-dog" src="/images/Dog_Sad.webp" alt="" width={180} height={180} widths={[180, 360]} sizes="180px" />}
  </div>}
  <div class="home-news-copy">
    <div class="home-news-meta">
      <span>{post?.categories.map(({ label }) => label).join(" / ") || (image ? copy.homeBlogHighlight : copy.homeBlogNote)}</span>
      {post?.createdAt && <time datetime={post.createdAt}>{post.dateLabel}</time>}
    </div>
    <h3>{post?.title ?? copy.homeBlogEmptySlot.replace("{number}", String(position))}</h3>
    <p>{post?.summary ?? (image ? copy.homeBlogImageEmpty : copy.homePostsEmpty)}</p>
    {post && <span class="home-news-open" aria-hidden="true">↗</span>}
  </div>
</Card>
