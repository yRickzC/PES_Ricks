---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../../../config/i18n";
import type { Messages } from "../../../utils/translations";
import SiteImage from "../../../components/site/SiteImage.astro";
import Icon from "../../../components/site/Icon.astro";

interface Props { copy: Messages; locale: Locale }
const { copy, locale } = Astro.props;
---

<section class="home-section home-services" aria-labelledby="home-services-title">
  <div class="home-services-mark" aria-hidden="true" data-home-reveal>
    <SiteImage src="/images/Rick_Logo_Transparent.webp" width={48} height={48} widths={[48, 96]} sizes="48px" alt="" loading="lazy" />
  </div>
  <div class="home-services-copy" data-home-reveal>
    <h2 id="home-services-title">{copy.homeServicesTitle}</h2>
    <p>{copy.homeServicesDescription}</p>
  </div>
  <a class="hero-action home-services-action" href={getRelativeLocaleUrl(locale, "services")} data-home-reveal>
    {copy.homeExploreServices}<Icon name="arrow" size={18} />
  </a>
</section>
