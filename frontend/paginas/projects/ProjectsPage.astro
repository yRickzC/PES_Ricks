---
import Main from "../../main.astro";
import { defaultLocale, locales } from "../../config/i18n";
import { getMessages } from "../../utils/translations";
import ProjectBiome from "./components/ProjectBiome.astro";
import { projectBiomes } from "./config/biomes";
import "./styles/project-biome.css";
import "../../styles/scroll-reveal.css";
import ProjectHero from "./components/ProjectHero.astro";
import { publicDir } from "astro:config/server";
import { fileURLToPath } from "node:url";
import { readPublicContent } from "../../../backend/content/node/pipeline";
import ContentEmptyState from "../../components/site/ContentEmptyState.astro";
import TaxonomyIcon from "../../components/site/TaxonomyIcon.astro";
import projectEnglish from "../../../public/i18n/projects.en.json";
import projectPortuguese from "../../../public/i18n/projects.pt-br.json";
import SiteImage from "../../components/site/SiteImage.astro";
import { withBasePath } from "../../utils/base-path";
import { taxonomyCategories } from "../../../backend/content/taxonomy";

const locale = locales.find((value) => value === Astro.currentLocale) ?? defaultLocale;
const copy = getMessages(locale);
const projectCopy = locale === "pt-br" ? projectPortuguese : projectEnglish;
const { database } = await readPublicContent(fileURLToPath(publicDir));
const categories = taxonomyCategories("project", locale);
const projectCategories = projectBiomes.map((biome) => categories.find(({ id }) => id === biome.category)!).map((category) => ({
  ...category,
  projects: database.list({ contentType: "project", locale, categories: [category.id] }),
}));
---

<Main locale={locale} pageId="projects" description={copy.projectsDescription}>
  <project-explore>
    <ProjectHero copy={copy} locale={locale} />
    <section id="projects-all" class="project-index" aria-label={copy.heroExploreProjects}>
      {projectCategories.map((category) => (
        <section class:list={["project-category-section", { "project-category-section--biome": projectBiomes.some((biome) => biome.category === category.id) }]} data-project-section={category.id} id={`projects-${category.id}`} aria-labelledby={`projects-${category.id}-title`}>
          <ProjectBiome category={category.id} />
          <div class="project-category-content">
            <header class="project-category-header" data-project-reveal>
              <TaxonomyIcon icon={category.icon} size={48} />
              <h3 id={`projects-${category.id}-title`}>{category.label}</h3>
            </header>
            {category.projects.length ? (
              <ul class="project-list">
                {category.projects.map(({ key, metadata }) => (
                  <li data-project-key={key} data-project-reveal>
                    <article class:list={["project-card", {
                      "project-card--linked": metadata.links.length > 0,
                      "project-card--single-link": metadata.links.length === 1,
                    }]}>
                      <SiteImage src={metadata.image.src} alt={metadata.image.alt} width={480} sizes="(max-width: 760px) 100vw, 480px" />
                      <div class="project-card-content">
                        <h4>{metadata.title}</h4>
                        <p>{metadata.description}</p>
                        {metadata.status && <span class="project-card-status">{metadata.status}</span>}
                        {metadata.tags.length > 0 && (
                          <ul class="project-card-tags" aria-label={projectCopy.tags}>
                            {metadata.tags.map((tag) => <li>{tag}</li>)}
                          </ul>
                        )}
                        {metadata.links.length > 0 && (
                          <div class="project-card-links">
                            {metadata.links.map((link) => (
                              <a href={withBasePath(link.url, import.meta.env.BASE_URL)}>
                                {link.label}
                                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M3 8h9m-4-4 4 4-4 4" />
                                </svg>
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            ) : (
              <ContentEmptyState class="project-empty-state" data-project-reveal-children headingLevel="h4" title={projectCopy.emptyTitle} hint={projectCopy.emptyHint} dogAlt={projectCopy.dogAlt}>
                <a class="project-empty-clear" href="#projects-all">{projectCopy.clear}</a>
              </ContentEmptyState>
            )}
          </div>
        </section>
      ))}
      <ContentEmptyState
        class="project-category-prompt"
        data-project-reveal-children
        title={projectCopy.selectCategoryTitle}
        hint={projectCopy.selectCategoryHint}
        dogSrc="/images/Dog_Thinking.webp"
        dogAlt=""
      />
    </section>
  </project-explore>
</Main>

<script>
  import { mountScrollReveal } from "../../utils/scroll-reveal";
  import { ProjectExplore } from "./utils/project-explore";

  if (!customElements.get("project-explore")) customElements.define("project-explore", ProjectExplore);

  const projects = document.querySelector("project-explore");
  if (projects) {
    const targets = projects.querySelectorAll<HTMLElement>("[data-project-reveal], [data-project-reveal-children] > *");
    mountScrollReveal(projects, targets);
  }
</script>
