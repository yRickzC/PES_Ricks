---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { projectBiomes, projectLayerStyle } from "../config/biomes";
import { withBasePath } from "../../../utils/base-path";
interface Props { category: string }
const biome = projectBiomes.find((item) => item.category === Astro.props.category);
const sources = import.meta.glob<ImageMetadata>("/public/images/*.png", { import: "default" });
const layers = await Promise.all((biome?.layers ?? []).map(async (layer) => {
  const source = await sources[`/public${layer.src}`]?.();
  if (!source) throw new Error(`Missing biome asset: ${layer.src}`);
  // Derive responsive WebP for every scene, keeping the original PNGs and alpha.
  const image = await getImage({ src: source, width: source.width, widths: [720, 1280, source.width].filter((width) => width <= source.width), format: "webp", quality: biome?.id === "crystal-cave" ? 85 : undefined });
  return { ...layer, url: withBasePath(image.src, import.meta.env.BASE_URL), width: Number(image.attributes.width), height: Number(image.attributes.height), srcset: image.srcSet.attribute };
}));
---
{biome && (
  <div class="project-biome-scene" data-project-biome={biome.id} aria-hidden="true">
    <noscript><style is:inline>.project-biome-scene { opacity: 1; } .project-biome-placement > img[data-biome-src] { display: none; }</style></noscript>
    {layers.map((layer) => (
      <div class={`project-biome-layer project-biome-layer--${layer.className}`} data-project-biome-layer={layer.id} style={projectLayerStyle(layer)}>
        <div class="project-biome-placement">
          <img data-biome-src={layer.url} data-biome-srcset={layer.srcset || undefined} sizes="(max-width: 760px) 1200px, 2172px" width={layer.width} height={layer.height} alt="" decoding="async" fetchpriority={layer.className === "cave-background" ? "auto" : "low"} draggable="false" />
          <noscript><img src={layer.url} srcset={layer.srcset || undefined} sizes="(max-width: 760px) 1200px, 2172px" width={layer.width} height={layer.height} alt="" loading="lazy" /></noscript>
        </div>
      </div>
    ))}
  </div>
)}
<script>
  import { mountProjectBiome } from "../utils/project-biome";
  const mounted = new Map<HTMLElement, () => void>();
  function mount() {
    document.querySelectorAll<HTMLElement>("[data-project-biome]").forEach((scene) => {
      if (!mounted.has(scene)) mounted.set(scene, mountProjectBiome(scene));
    });
  }
  mount();
  document.addEventListener("astro:page-load", mount);
  document.addEventListener("astro:before-swap", () => {
    mounted.forEach((cleanup) => cleanup());
    mounted.clear();
  });
</script>
