---
import { getImage } from "astro:assets";
import mainForest from "../../../../public/images/Project_Hero_MainFlorest.webp";
import fog from "../../../../public/images/Project_Hero_Fog.webp";
import foreground from "../../../../public/images/Project_Hero_Florest.webp";
import SiteImage from "../../../components/site/SiteImage.astro";
import TaxonomyIcon from "../../../components/site/TaxonomyIcon.astro";
import { taxonomyCategories } from "../../../../backend/content/taxonomy";
import type { Locale } from "../../../config/i18n";
import type { Messages } from "../../../utils/translations";
import { projectHeroLayers } from "../config/hero";
import "../styles/project-hero.css";

interface Props { copy: Messages; locale: Locale }
const { copy, locale } = Astro.props;
const projectCategories = taxonomyCategories("project", locale);
const orbitRadius = 42;
const assets = { main: mainForest, fog, foreground };
const scenery = await Promise.all(projectHeroLayers.map(async (layer) => ({
  ...layer,
  image: layer.id === "sky" ? layer.src : (await getImage({ src: assets[layer.id], width: 2172, format: "webp" })).src,
})));
---

<section class="project-hero" data-project-hero aria-labelledby="project-hero-title">
  <div class="project-hero-scene" aria-hidden="true">
    {scenery.map((layer) => (
      <div class={`project-hero-layer project-hero-layer--${layer.id}`} data-project-layer={layer.id} style={`z-index: ${layer.zIndex};`}>
        {layer.id === "sky" ? (
          <SiteImage src={layer.src} alt="" width={1672} widths={[960, 1672]} sizes="100vw" loading="eager" decoding="async" draggable="false" />
        ) : (
          <div class="project-hero-panorama" style={`background-image: url("${layer.image}");`}></div>
        )}
      </div>
    ))}
  </div>
  <div class="project-hero-content">
    <div class="project-hero-orbit" data-expanded={projectCategories.length > 7 ? "true" : undefined}>
      <SiteImage class="project-hero-logo" src="/images/Rick_Logo_Transparent.webp" alt="" width={192} widths={[128, 192, 384]} sizes="(max-width: 760px) 122px, 146px" loading="eager" decoding="async" />
      <nav class="project-categories" aria-label={copy.projectCategoriesLabel}>
        {projectCategories.map((category, index) => {
          const angle = -Math.PI / 2 + index * Math.PI * 2 / projectCategories.length;
          const position = `--category-x: ${50 + Math.cos(angle) * orbitRadius}%; --category-y: ${50 + Math.sin(angle) * orbitRadius}%;`;
          return (
            <a class="project-category-link" data-project-filter={category.id} aria-controls={`projects-${category.id}`} href={`#projects-${category.id}`} style={position}>
              <span class="project-category-icon"><TaxonomyIcon icon={category.icon} size={24} /></span>
              <span class="project-category-label">{category.label}</span>
            </a>
          );
        })}
      </nav>
    </div>
    <h1 id="project-hero-title">{copy.projectsLabel}</h1>
    <p class="project-hero-description">{copy.projectsDescription}</p>
  </div>
</section>

<script>
  import { mountProjectHeroParallax } from "../utils/hero-parallax";

  const mounted = new Map<HTMLElement, () => void>();
  function mountProjectHeroes() {
    document.querySelectorAll<HTMLElement>("[data-project-hero]").forEach((hero) => {
      if (!mounted.has(hero)) mounted.set(hero, mountProjectHeroParallax(hero));
    });
  }
  mountProjectHeroes();
  document.addEventListener("astro:page-load", mountProjectHeroes);
  document.addEventListener("astro:before-swap", () => {
    mounted.forEach((cleanup) => cleanup());
    mounted.clear();
  });
</script>
